__pycache__/
*.pyc
.venv/
*.json.tmp
.env
build/
*.egg-info/
# Las imágenes generadas o descargadas pesan: se quedan locales.
partidas/*/imagenes/*.png
partidas/*/imagenes/*.jpg
partidas/*/imagenes/*.jpeg
partidas/*/imagenes/*.webp
# Candado y diario de transacción: estado de ejecución, no de la historia.
partidas/*/.candado
partidas/*/.transaccion.json*
partidas/*/eventos.jsonl.tmp
# La sesión del narrador del chat (ACP) es de esta máquina; la conversación (chat.jsonl) sí viaja.
partidas/*/.narrador.json
# La caché del catálogo externo se regenera con `bin/mesa fuentes actualizar`: no viaja en git.
biblioteca/fuentes/
# Las partidas son de cada mesa y se quedan en su equipo; viajan la plantilla y la de ejemplo.
partidas/*
!partidas/_plantilla/
!partidas/los-hermanos-del-neva/
# La partida activa también es de cada equipo.
.mesa-activa
